# Copy to apps/api/.env
DATABASE_URL=postgresql://tm:tm_dev_password@localhost:55432/taskmanager
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Seed (dev only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
# Reminders
REMINDERS_ENABLED=true
REMINDER_TICK_SECONDS=300
# Optional email delivery (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Task Manager <no-reply@example.com>
# File storage (MinIO / any S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=task-attachments
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_password
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=25

# Key used to encrypt secrets saved from the admin settings page (SMTP password, push private key).
# Use a long random value in production. Do not change it later, or saved secrets must be entered again.
SETTINGS_ENCRYPTION_KEY=change-me-long-random-string
