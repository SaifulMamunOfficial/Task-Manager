{
  "expo": {
    "name": "Task Manager",
    "slug": "task-manager",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "taskmanager",
    "plugins": [
      "expo-secure-store",
      ["expo-notifications", { "color": "#4f46e5" }],
      ["@react-native-community/datetimepicker"]
    ],
    "ios": { "supportsTablet": false, "bundleIdentifier": "org.example.taskmanager" },
    "android": { "package": "org.example.taskmanager", "permissions": ["POST_NOTIFICATIONS"] },
    "extra": { "eas": { "projectId": "" } }
  }
}
