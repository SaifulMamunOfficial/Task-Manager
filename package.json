{
  "name": "task-manager",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/api", "apps/web", "packages/*"],
  "scripts": {
    "build:shared": "npm run build -w @tm/shared",
    "build:api": "npm run build -w @tm/api",
    "dev:api": "npm run start:dev -w @tm/api",
    "dev:web": "npm run dev -w @tm/web",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run prisma:migrate -w @tm/api",
    "db:seed": "npm run prisma:seed -w @tm/api"
  }
}
